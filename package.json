{
  "name": "pddc-iims",
  "version": "0.1.0",
  "private": true,
  "description": "PDDC Intelligence & Investigation Management System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "verify:audit-chain": "node --env-file=.env.local scripts/verify-audit-chain.mjs",
    "check:coexistence": "node --env-file=.env.local scripts/check-coexistence.mjs",
    "docs:schema": "node --env-file=.env.local scripts/doc-schema.mjs",
    "test": "node --env-file-if-exists=.env.local ./node_modules/vitest/dist/cli.js run",
    "test:watch": "node --env-file-if-exists=.env.local ./node_modules/vitest/dist/cli.js",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file-if-exists=.env.local ./node_modules/vitest/dist/cli.js run tests/integration",
    "test:unit": "node ./node_modules/vitest/dist/cli.js run src",
    "seed:e2e": "tsx --env-file=.env.local scripts/seed-e2e-users.ts",
    "grant-access": "tsx --env-file=.env.local scripts/grant-iims-access.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "cytoscape": "^3.34.4",
    "date-fns": "^4.4.0",
    "docx": "^9.13.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
