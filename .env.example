# ===========================================================================
# PDDC IIMS environment
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env* is gitignored: never commit real
# values. The IIMS shares a Supabase project with the live primaddc.com site,
# so treat every credential here as production.
# ===========================================================================

# --- Supabase project (shared with primaddc.com) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_REF=

# Break-glass only. Used by scripts/db-migrate.mjs (session-mode pooler,
# port 5432) and by nothing at runtime. The application must never use the
# postgres role or the service-role key for data access: both bypass RLS,
# which would void the append-only audit guarantee (PRD §13).
SUPABASE_DB_URL=

# Required for Supabase Auth admin calls only (invite, ban, session listing).
# Bypasses RLS, so it is never used for reading or writing case data.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API / CLI token. Local tooling only.
SUPABASE_ACCESS_TOKEN=

# --- Runtime database role -------------------------------------------------
# The restricted iims_app role, over the transaction-mode pooler (port 6543).
# Has INSERT-only rights on the audit schema and no rights at all outside the
# ten IIMS schemas. Created by supabase/migrations/0001_roles_and_grants.sql.
IIMS_APP_DB_URL=

# Password for the iims_app role. Set once, then applied (or rotated) by
# scripts/bootstrap-app-role.mjs. Never placed in a committed migration.
IIMS_APP_DB_PASSWORD=

# Pool size per server instance. Default 5. One connection would serialise
# every query in the process, which looks like a hang rather than a slow page;
# much more than this multiplies across instances against the pooler's client
# limit, which is shared with the live website.
IIMS_DB_MAX_CONNECTIONS=

# Set to 1 to log one line per SQL statement: shape only, never parameter
# values, which carry subject names and evidence metadata. The quickest way to
# see why a page is slow, since the cost is round trips to the database's
# region rather than slow queries. Leave empty outside diagnosis.
IIMS_DB_DEBUG=

# --- Single sign-on with primaddc.com --------------------------------------
# Parent domain the Supabase session cookie is scoped to, so signing in on
# either app signs the employee into both. Leave EMPTY for localhost.
# Production: .primaddc.com
COOKIE_DOMAIN=

# --- Email (Resend) --------------------------------------------------------
# Also configured as Supabase Auth's custom SMTP provider: the built-in
# sender is capped at 2 emails/hour project-wide.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# --- Background workers ----------------------------------------------------
# Shared secret pg_cron presents when calling the worker route handlers.
# Stored in Supabase Vault on the database side.
CRON_WORKER_SECRET=

# --- AI gateway (free tiers only; all optional) ----------------------------
# Every provider is off until an administrator adds it to the allow-list.
# Nothing above INTERNAL classification is ever sent (PRD §22.4).
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
